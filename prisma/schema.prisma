generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Cliente {
  ID                     Int                      @id @unique(map: "ID_UNIQUE") @default(autoincrement()) @db.UnsignedInt
  CPF                    String?                  @db.VarChar(11)
  nome                   String?                  @db.VarChar(75)
  data_nascimento        DateTime?                @db.Date
  email                  String?                  @db.VarChar(50)
  senha                  String?                  @db.VarChar(45)
  telefone               String?                  @db.VarChar(15)
  Compras                Compras[]
  Enderecos_Clientes     Enderecos_Clientes[]
  Historico_de_transacao Historico_de_transacao[]
  Notas_Fiscais          Notas_Fiscais[]
}

model Compras {
  ID                                Int                    @unique(map: "ID_UNIQUE") @default(autoincrement())
  status                            String?                @db.VarChar(45)
  item                              String?                @db.VarChar(45)
  datahora_compra                   DateTime?              @db.DateTime(0)
  Historico_de_transacao_ID         Int
  Historico_de_transacao_Cliente_ID Int                    @db.UnsignedInt
  Cliente_ID                        Int                    @db.UnsignedInt
  Notas_Fiscais_ID                  Int                    @map("Notas Fiscais_ID")
  Cliente                           Cliente                @relation(fields: [Cliente_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Compras_Cliente1")
  Historico_de_transacao            Historico_de_transacao @relation(fields: [Historico_de_transacao_ID, Historico_de_transacao_Cliente_ID], references: [ID, Cliente_ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Compras_Histórico de transação1")
  Notas_Fiscais                     Notas_Fiscais          @relation(fields: [Notas_Fiscais_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Compras_Notas Fiscais1")

  @@id([ID, Historico_de_transacao_ID, Historico_de_transacao_Cliente_ID, Cliente_ID, Notas_Fiscais_ID])
  @@index([Cliente_ID], map: "fk_Compras_Cliente1_idx")
  @@index([Historico_de_transacao_ID, Historico_de_transacao_Cliente_ID], map: "fk_Compras_Histórico de transação1_idx")
  @@index([Notas_Fiscais_ID], map: "fk_Compras_Notas Fiscais1_idx")
}

model Enderecos_Clientes {
  ID          Int     @unique(map: "ID_UNIQUE") @default(autoincrement())
  Cidade      String? @db.VarChar(45)
  Bairro      String? @db.VarChar(45)
  Rua         String? @db.VarChar(45)
  CEP         Int?
  NUMERO      Int?
  COMPLEMENTO String? @db.VarChar(45)
  Cliente_ID  Int     @db.UnsignedInt
  Cliente     Cliente @relation(fields: [Cliente_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Endereços_Clientes_Cliente1")

  @@id([ID, Cliente_ID])
  @@index([Cliente_ID], map: "fk_Endereços_Clientes_Cliente1_idx")
}

model Enderecos_Funcionarios {
  ID          Int     @id @unique(map: "ID_UNIQUE") @default(autoincrement())
  Cidade      String? @db.VarChar(45)
  Bairro      String? @db.VarChar(45)
  Rua         String? @db.VarChar(45)
  CEP         Int?
  NUMERO      Int?
  COMPLEMENTO String? @db.VarChar(45)
}

model Estornos {
  ID               Int          @unique(map: "ID_UNIQUE") @default(autoincrement())
  datahora_estorno DateTime?    @db.DateTime(0)
  Motivo           String?      @db.TinyText
  Status           String?      @db.VarChar(45)
  Funcionario_ID   Int          @db.UnsignedInt
  Funcionario      Funcionario  @relation(fields: [Funcionario_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Estornos_Funcionário1")
  Pagamentos       Pagamentos[]

  @@id([ID, Funcionario_ID])
  @@index([Funcionario_ID], map: "fk_Estornos_Funcionário1_idx")
}

model Faturamento {
  id               Int      @id @unique(map: "id_UNIQUE") @default(autoincrement())
  data_faturamento DateTime @unique(map: "data_faturamento_UNIQUE") @db.Date
  valor            Decimal  @db.Decimal(10, 2)
}

model Funcionario {
  ID                    Int        @unique(map: "ID_UNIQUE") @default(autoincrement()) @db.UnsignedInt
  CPF                   String?    @db.VarChar(11)
  data_nascimento       DateTime?  @db.Date
  nome                  String?    @db.VarChar(75)
  cargo                 String?    @db.VarChar(45)
  email                 String?    @db.VarChar(50)
  senha                 String?    @db.VarChar(45)
  data_admissao         DateTime?  @db.Date
  telefone              String?    @db.VarChar(15)
  ativo                 Int?       @db.TinyInt
  Enderecos_Clientes_ID Int
  Estornos              Estornos[]

  @@id([ID, Enderecos_Clientes_ID])
  @@index([Enderecos_Clientes_ID], map: "fk_Funcionário_Endereços_Clientes_copy11_idx")
}

model Historico_de_transacao {
  ID                 Int          @unique(map: "ID_UNIQUE") @default(autoincrement())
  valor              Float?       @db.Float
  datahora_transacao DateTime?    @db.DateTime(0)
  descricao          String?      @db.VarChar(45)
  metodo_pagamentos  String?      @db.VarChar(45)
  Cliente_ID         Int          @db.UnsignedInt
  Compras            Compras[]
  Cliente            Cliente      @relation(fields: [Cliente_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Histórico de transação_Cliente")
  Pagamentos         Pagamentos[]

  @@id([ID, Cliente_ID])
  @@index([Cliente_ID], map: "fk_Histórico de transação_Cliente_idx")
}

model Notas_Fiscais {
  ID            Int       @unique(map: "ID_UNIQUE") @default(autoincrement())
  descricao     String?   @db.VarChar(45)
  valor         String?   @db.VarChar(45)
  datahora_nota DateTime? @db.DateTime(0)
  Cliente_ID    Int       @db.UnsignedInt
  Compras       Compras[]
  Cliente       Cliente   @relation(fields: [Cliente_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Notas Fiscais_Cliente1")

  @@id([ID, Cliente_ID])
  @@index([Cliente_ID], map: "fk_Notas Fiscais_Cliente1_idx")
}

model Pagamentos {
  Id                                Int                    @unique(map: "Id_UNIQUE") @default(autoincrement())
  valor                             Float?                 @db.Float
  datahora_pagamento                DateTime?              @db.DateTime(0)
  metodo_pagamento                  String?                @db.VarChar(45)
  descricao                         String?                @db.VarChar(45)
  status                            String?                @db.VarChar(45)
  Historico_de_transacao_ID         Int
  Historico_de_transacao_Cliente_ID Int                    @db.UnsignedInt
  Estornos_ID                       Int
  Estornos                          Estornos               @relation(fields: [Estornos_ID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Pagamentos_Estornos1")
  Historico_de_transacao            Historico_de_transacao @relation(fields: [Historico_de_transacao_ID, Historico_de_transacao_Cliente_ID], references: [ID, Cliente_ID], onDelete: NoAction, onUpdate: NoAction, map: "fk_Pagamentos_Histórico de transação1")

  @@id([Id, Historico_de_transacao_ID, Historico_de_transacao_Cliente_ID, Estornos_ID])
  @@index([Estornos_ID], map: "fk_Pagamentos_Estornos1_idx")
  @@index([Historico_de_transacao_ID, Historico_de_transacao_Cliente_ID], map: "fk_Pagamentos_Histórico de transação1_idx")
}
