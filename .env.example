# Copie para `.env` e preencha:  cp .env.example .env
# O compose monta a DATABASE_URL interna como:
#   mysql://${DB_USER}:${DB_PASSWORD}@db:3306/${DB_NAME}
# Para rodar a API fora do Docker (npm run start:dev), descomente e ajuste
# DATABASE_URL apontando para localhost.

PORT=5000

DB_NAME=security_finance
DB_USER=app
DB_PASSWORD=troque_esta_senha
DB_ROOT_PASSWORD=troque_esta_senha_root
DB_PORT=3306

JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Uso local fora do Docker (ex.: `npx prisma migrate dev`):
# DATABASE_URL="mysql://app:troque_esta_senha@localhost:3306/security_finance"
